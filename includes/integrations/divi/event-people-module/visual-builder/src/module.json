  }
}
  },
  "settings": {
    "content": "auto", "design": "auto", "advanced": "auto",
    "groups": {
      "contentPeopleTitle": {"panel": "content", "priority": 10, "groupName": "contentPeopleTitle", "multiElements": true, "component": {"name": "divi/composite", "props": {"groupLabel": "Titre"}}},
      "contentPeopleFilter": {"panel": "content", "priority": 20, "groupName": "contentPeopleFilter", "multiElements": true, "component": {"name": "divi/composite", "props": {"groupLabel": "Filtrage"}}},
      "contentPeopleName": {"panel": "content", "priority": 30, "groupName": "contentPeopleName", "multiElements": true, "component": {"name": "divi/composite", "props": {"groupLabel": "Nom"}}},
      "contentPeopleEmail": {"panel": "content", "priority": 40, "groupName": "contentPeopleEmail", "multiElements": true, "component": {"name": "divi/composite", "props": {"groupLabel": "Email"}}},
      "contentPeoplePhone": {"panel": "content", "priority": 50, "groupName": "contentPeoplePhone", "multiElements": true, "component": {"name": "divi/composite", "props": {"groupLabel": "Téléphone"}}},
      "contentPeopleLinks": {"panel": "content", "priority": 60, "groupName": "contentPeopleLinks", "multiElements": true, "component": {"name": "divi/composite", "props": {"groupLabel": "Liens"}}},
      "contentPeopleLayout": {"panel": "content", "priority": 70, "groupName": "contentPeopleLayout", "multiElements": true, "component": {"name": "divi/composite", "props": {"groupLabel": "Disposition"}}},
      "contentPeopleSeparators": {"panel": "content", "priority": 80, "groupName": "contentPeopleSeparators", "multiElements": true, "component": {"name": "divi/composite", "props": {"groupLabel": "Séparateurs"}}},
