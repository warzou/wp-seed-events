    "sectionStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-people-section"},
    "titleStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-people__title", "settings": {"decoration": {
      "font": {"component": {"props": {"groupLabel": "Titre", "fieldLabel": "Titre"}}}
    }}},
    "listStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-people__list"},
    "itemStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-people__item", "settings": {"decoration": {
      "background": {"component": {"props": {"groupLabel": "Personne"}}}
    }}},
    "nameStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-people__name", "settings": {"decoration": {
      "font": {"component": {"props": {"groupLabel": "Nom", "fieldLabel": "Nom"}}}
    }}},
    "rolesStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-people__roles"},
    "roleStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-people__role"},
    "contactsStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-people__contacts, {{selector}} .wp-seed-event-people__email-link, {{selector}} .wp-seed-event-people__email-text, {{selector}} .wp-seed-event-people__phone-link, {{selector}} .wp-seed-event-people__phone-text, {{selector}} .wp-seed-event-people__link-anchor, {{selector}} .wp-seed-event-people__link-text", "settings": {"decoration": {
	  "font": {"component": {"props": {"groupLabel": "Coordonnées", "fieldLabel": "Coordonnées"}}}
    }}},
    "emailLinkStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-people__email-link, {{selector}} .wp-seed-event-people__email-text"},
    "phoneLinkStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-people__phone-link, {{selector}} .wp-seed-event-people__phone-text"},
    "publicLinkStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-people__link-anchor, {{selector}} .wp-seed-event-people__link-text"},
"contactSeparatorStyle": {
  "type": "object",
  "selector": "{{selector}} .wp-seed-event-people__contact-separator:not(.wp-seed-event-people__contact-separator--name)",
  "supportsCustomAttributes": true,
  "default": {"advanced": {
    "color": {"desktop": {"value": ""}},
    "fontSize": {"desktop": {"value": "1em"}},
    "spaceBefore": {"desktop": {"value": "0.35em"}},
    "spaceAfter": {"desktop": {"value": "0.35em"}}
  }}
},
"nameContactSeparatorStyle": {
  "type": "object",
  "selector": "{{selector}} .wp-seed-event-people__contact-separator--name",
  "supportsCustomAttributes": true,
  "default": {"advanced": {
    "color": {"desktop": {"value": ""}},
    "fontSize": {"desktop": {"value": "1em"}},
    "spaceBefore": {"desktop": {"value": "0.35em"}},
    "spaceAfter": {"desktop": {"value": "0.35em"}}
  }},
  "settings": {"advanced": {
    "color": {"groupType": "group-item", "item": {
      "groupSlug": "designPeopleNameSeparator", "attrName": "nameContactSeparatorStyle.advanced.color", "subName": "color",
      "label": "Couleur", "priority": 10, "render": true,
      "features": {"dynamicContent": false, "responsive": true, "hover": false, "sticky": false, "preset": ["style"]},
      "component": {"type": "field", "name": "divi/color-picker"}
    }},
    "fontSize": {"groupType": "group-item", "item": {
      "groupSlug": "designPeopleNameSeparator", "attrName": "nameContactSeparatorStyle.advanced.fontSize", "subName": "fontSize",
      "label": "Taille", "priority": 20, "render": true,
      "features": {"dynamicContent": false, "responsive": true, "hover": false, "sticky": false, "preset": ["style"]},
      "component": {"type": "field", "name": "divi/range", "props": {"cssProperty": "font-size", "min": 0, "max": 120}}
    }},
    "spaceBefore": {"groupType": "group-item", "item": {
      "groupSlug": "designPeopleNameSeparator", "attrName": "nameContactSeparatorStyle.advanced.spaceBefore", "subName": "spaceBefore",
      "label": "Espacement avant", "priority": 30, "render": true,
      "features": {"dynamicContent": false, "responsive": true, "hover": false, "sticky": false, "preset": ["style"]},
      "component": {"type": "field", "name": "divi/range", "props": {"cssProperty": "margin-inline-start", "min": 0, "max": 120}}
    }},
    "spaceAfter": {"groupType": "group-item", "item": {
      "groupSlug": "designPeopleNameSeparator", "attrName": "nameContactSeparatorStyle.advanced.spaceAfter", "subName": "spaceAfter",
      "label": "Espacement apr\u00e8s", "priority": 40, "render": true,
      "features": {"dynamicContent": false, "responsive": true, "hover": false, "sticky": false, "preset": ["style"]},
      "component": {"type": "field", "name": "divi/range", "props": {"cssProperty": "margin-inline-end", "min": 0, "max": 120}}
    }}
  }}
},
"eventListStyle": {
  "type": "object",
