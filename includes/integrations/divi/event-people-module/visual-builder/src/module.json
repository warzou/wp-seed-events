          "groupSlug": "designPeopleList",
          "attrName": "eventListStyle.advanced.leftIndent",
          "subName": "leftIndent",
          "label": "Retrait gauche de la liste",
          "priority": 30,
          "render": true,
          "features": {
            "dynamicContent": false,
            "responsive": true,
            "hover": false,
            "sticky": false,
            "preset": [
