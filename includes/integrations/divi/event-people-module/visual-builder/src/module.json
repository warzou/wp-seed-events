{
  "name": "wp-seed-events/event-people",
  "d4Shortcode": "",
  "title": "WP Seed — Personnes de l’événement",
  "titles": "WP Seed — Personnes de l’événement",
  "folder": "wp-seed-events",
  "category": "module",
  "moduleClassName": "wp_seed_events_divi_event_people",
  "moduleOrderClassName": "wp_seed_events_divi_event_people",
  "usesContext": ["postId", "postType", "queryId"],
  "attributes": {
    "__loop_post_id": {"type": "string", "default": ""},
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {"meta": {"adminLabel": {"desktop": {"value": "WP Seed — Personnes de l’événement"}}}},
      "settings": {
        "meta": {"adminLabel": {}},
        "advanced": {"htmlAttributes": {}, "loop": {}},
        "decoration": {
          "layout": {"component": {"props": {"groupLabel": "Module"}}}
        }
      }
    },
    "content": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "title": "Contacts et intervenants",
              "heading_level": "h2",
              "role": "all",
			  "people_contract": "composable-v3",
              "show_name": "on",
              "show_roles": "off",
              "show_email": "on",
              "show_phone": "on",
              "show_link": "on",
			  "email_clickable": "on",
			  "phone_clickable": "on",
			  "site_clickable": "on",
			  "contact_layout": "stacked",
			  "show_contact_separator": "off",
			  "contact_separator": "\u2014",
			  "show_name_contact_separator": "off",
			  "name_contact_separator": "\u2014",
              "layout": "list",
              "show_title": "on"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "title": {
              "groupSlug": "contentPeopleTitle", "priority": 20, "render": true, "subName": "title",
              "label": "Titre", "description": "Laissez vide pour masquer le titre.",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/text", "type": "field"}
            },
            "headingLevel": {
              "groupSlug": "contentPeopleTitle", "priority": 30, "render": true, "subName": "heading_level",
              "label": "Niveau du titre",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/select", "type": "field", "props": {"options": {
                "h2": {"label": "H2"}, "h3": {"label": "H3"}, "h4": {"label": "H4"},
                "h5": {"label": "H5"}, "h6": {"label": "H6"}
              }}}
            },
            "showName": {
              "groupSlug": "contentPeopleName", "priority": 10, "render": true, "subName": "show_name",
              "label": "Afficher le nom",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/toggle", "type": "field", "props": {"options": {"off": "Non", "on": "Oui"}}}
            },
            "showEmail": {
              "groupSlug": "contentPeopleEmail", "priority": 10, "render": true, "subName": "show_email",
              "label": "Afficher les emails autorisés",
              "description": "Les coordonnées sont privées par défaut. Divi ne peut afficher que les emails autorisés dans l’événement.",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/toggle", "type": "field", "props": {"options": {"off": "Masquer", "on": "Afficher"}}}
            },
            "showPhone": {
              "groupSlug": "contentPeoplePhone", "priority": 10, "render": true, "subName": "show_phone",
              "label": "Afficher les téléphones autorisés",
              "description": "Masquer ce champ dans Divi ne modifie pas son autorisation de publication.",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/toggle", "type": "field", "props": {"options": {"off": "Masquer", "on": "Afficher"}}}
            },
            "showLink": {
              "groupSlug": "contentPeopleLinks", "priority": 10, "render": true, "subName": "show_link",
              "label": "Afficher les liens autorisés",
              "description": "Une coordonnée non autorisée dans l’événement ne peut jamais être rendue publique par Divi.",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/toggle", "type": "field", "props": {"options": {"off": "Masquer", "on": "Afficher"}}}
            },
            "emailClickable": {
              "groupSlug": "contentPeopleEmail", "priority": 20, "render": true, "subName": "email_clickable",
              "label": "Email cliquable",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/toggle", "type": "field", "props": {"options": {"off": "Non", "on": "Oui"}}}
            },
            "phoneClickable": {
              "groupSlug": "contentPeoplePhone", "priority": 20, "render": true, "subName": "phone_clickable",
              "label": "Téléphone cliquable",
              "description": "Activé, le module respecte l’action Aucun, Appel ou SMS définie pour cette personne dans l’événement. Désactivé, le numéro reste en texte simple.",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/toggle", "type": "field", "props": {"options": {"off": "Non", "on": "Oui"}}}
            },
            "siteClickable": {
              "groupSlug": "contentPeopleLinks", "priority": 20, "render": true, "subName": "site_clickable",
              "label": "Liens cliquables",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/toggle", "type": "field", "props": {"options": {"off": "Non", "on": "Oui"}}}
            },
            "contactLayout": {
              "groupSlug": "contentPeopleLayout", "priority": 10, "render": true, "subName": "contact_layout",
              "label": "Disposition des coordonn\u00e9es",
              "features": {"sticky": false, "responsive": true, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/select", "type": "field", "props": {"options": {
                "stacked": {"label": "En dessous"}, "inline": {"label": "En ligne"}, "with_name": {"label": "Avec le nom"}
              }}}
            },
            "showContactSeparator": {
              "groupSlug": "contentPeopleSeparators", "priority": 10, "render": true, "subName": "show_contact_separator",
              "label": "Afficher le s\u00e9parateur en ligne",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/toggle", "type": "field", "props": {"options": {"off": "Non", "on": "Oui"}}}
            },
            "contactSeparator": {
              "groupSlug": "contentPeopleSeparators", "priority": 20, "render": true, "subName": "contact_separator",
              "label": "Caract\u00e8re du s\u00e9parateur",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/text", "type": "field"}
            },
            "showNameContactSeparator": {
              "groupSlug": "contentPeopleSeparators", "priority": 30, "render": true, "subName": "show_name_contact_separator",
              "label": "Afficher le s\u00e9parateur Nom / Coordonn\u00e9es",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/toggle", "type": "field", "props": {"options": {"off": "Non", "on": "Oui"}}}
            },
            "nameContactSeparator": {
              "groupSlug": "contentPeopleSeparators", "priority": 40, "render": true, "subName": "name_contact_separator",
              "label": "Caract\u00e8re Nom / Coordonn\u00e9es",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/text", "type": "field"}
            },
            "showTitle": {
              "groupSlug": "contentPeopleTitle",
              "priority": 10,
              "render": true,
              "subName": "show_title",
              "label": "Afficher le titre",
              "features": {
                "sticky": false,
                "responsive": false,
                "hover": false,
                "dynamicContent": false
              },
              "component": {
                "name": "divi/toggle",
                "type": "field",
                "props": {
                  "options": {
                    "off": "Non",
                    "on": "Oui"
                  }
                }
              }
            }
          }
        }
      }
