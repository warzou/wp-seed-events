        "desktop": {
          "value": "0px"
        }
      },
      "markerColor": {
        "desktop": {
          "value": ""
        }
      }
    }
  },
  "settings": {
    "advanced": {
      "markerType": {
        "groupType": "group-item",
        "item": {
          "groupSlug": "designPeopleList",
          "attrName": "eventListStyle.advanced.markerType",
          "subName": "markerType",
