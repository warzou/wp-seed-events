{
  "name": "wp-seed-events/event-dates",
  "d4Shortcode": "",
  "title": "WP Seed — Dates de l’événement",
  "titles": "WP Seed — Dates de l’événement",
  "folder": "wp-seed-events",
  "category": "module",
  "moduleClassName": "wp_seed_events_divi_event_dates",
  "moduleOrderClassName": "wp_seed_events_divi_event_dates",
  "usesContext": ["postId", "queryId"],
  "attributes": {
    "__loop_post_id": {"type": "string", "default": ""},
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "WP Seed — Dates de l’événement"
            }
          }
        }
      },
      "settings": {
        "meta": {"adminLabel": {}},
        "advanced": {"htmlAttributes": {}},
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "content": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "title": "Dates",
              "heading_level": "h2",
              "mode": "all",
              "scope": "all",
              "show_cancelled": "on",
              "show_times": "on",
              "format": "long",
              "show_calendar_links": "on"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "title": {
              "groupSlug": "contentDates",
              "priority": 10,
              "render": true,
              "subName": "title",
              "label": "Titre",
              "description": "Laissez vide pour masquer le titre.",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {"name": "divi/text", "type": "field"}
            },
            "headingLevel": {
              "groupSlug": "contentDates",
              "priority": 20,
              "render": true,
              "subName": "heading_level",
              "label": "Niveau du titre",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "options": {
                    "h2": {"label": "H2"},
                    "h3": {"label": "H3"},
                    "h4": {"label": "H4"},
                    "h5": {"label": "H5"},
                    "h6": {"label": "H6"}
                  }
                }
              }
            },
            "dateSelection": {
              "groupSlug": "contentDates",
              "priority": 25,
              "render": true,
              "subName": "date_selection",
              "label": "Dates affich\u00e9es",
              "description": "Choisissez directement les dates \u00e0 afficher. Premi\u00e8re date et Derni\u00e8re date portent sur toutes les dates de l\u2019\u00e9v\u00e9nement.",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "options": {
                    "next": {"label": "Prochaine date"},
                    "first": {"label": "Premi\u00e8re date"},
                    "last": {"label": "Derni\u00e8re date"},
                    "all_upcoming": {"label": "Toutes les prochaines dates"},
                    "all_past": {"label": "Toutes les dates pass\u00e9es"},
                    "all": {"label": "Toutes les dates"}
                  }
                }
              }
            },
            "showCancelled": {
              "groupSlug": "contentDates",
              "priority": 40,
              "render": true,
              "subName": "show_cancelled",
              "label": "Occurrences annulées",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {
                "name": "divi/toggle",
                "type": "field",
                "props": {"options": {"off": "Masquer", "on": "Afficher"}}
              }
            },
            "showTimes": {
              "groupSlug": "contentDates",
              "priority": 50,
              "render": true,
              "subName": "show_times",
              "label": "Horaires",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {
                "name": "divi/toggle",
                "type": "field",
                "props": {"options": {"off": "Masquer", "on": "Afficher"}}
              }
            },
            "format": {
              "groupSlug": "contentDates",
              "priority": 55,
              "render": true,
              "subName": "format",
              "label": "Format des dates",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "options": {
                    "long": {"label": "Format long"},
                    "short": {"label": "Format court"}
                  }
                }
              }
            },
            "showCalendarLinks": {
              "groupSlug": "contentDates",
              "priority": 60,
              "render": true,
              "subName": "show_calendar_links",
              "label": "Liens calendrier",
              "features": {"sticky": false, "responsive": false, "hover": false, "dynamicContent": false},
              "component": {
                "name": "divi/toggle",
                "type": "field",
                "props": {"options": {"off": "Masquer", "on": "Afficher"}}
              }
            }
          }
        }
      }
    },
    "titleStyle": {
      "type": "object",
      "selector": "{{selector}} .wp-seed-event-dates__title",
      "settings": {
        "decoration": {
          "font": {"priority": 10, "component": {"props": {"groupLabel": "Titre", "fieldLabel": "Titre"}}},
          "spacing": {"priority": 20, "component": {"props": {"groupLabel": "Espacement du titre"}}}
        }
      }
    },
    "dateStyle": {
      "type": "object",
      "selector": "{{selector}} .wp-seed-event-date__date",
      "settings": {"decoration": {"font": {"component": {"props": {"groupLabel": "Date", "fieldLabel": "Date"}}}}}
    },
    "timeStyle": {
      "type": "object",
      "selector": "{{selector}} .wp-seed-event-date__time",
      "settings": {"decoration": {"font": {"component": {"props": {"groupLabel": "Horaire", "fieldLabel": "Horaire"}}}}}
    },
    "statusStyle": {
      "type": "object",
      "selector": "{{selector}} .wp-seed-event-date__status",
      "settings": {"decoration": {"font": {"component": {"props": {"groupLabel": "État annulé", "fieldLabel": "État annulé"}}}}}
    },
    "calendarLinkStyle": {
      "type": "object",
      "selector": "{{selector}} .wp-seed-event-calendar-link",
      "settings": {"decoration": {"font": {"component": {"props": {"groupLabel": "Liens calendrier", "fieldLabel": "Liens calendrier"}}}}}
    },
    "occurrenceStyle": {
      "type": "object",
      "selector": "{{selector}} .wp-seed-event-date",
      "settings": {"decoration": {"spacing": {"component": {"props": {"groupLabel": "Occurrence"}}}}}
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentDates": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentDates",
        "multiElements": true,
        "component": {"name": "divi/composite", "props": {"groupLabel": "Dates de l’événement"}}
      }
    }
  }
}
