{
  "name": "wp-seed-events/event-visuals",
  "d4Shortcode": "",
  "title": "WPSEvents — Visuels",
  "titles": "WPSEvents — Visuels",
  "folder": "wp-seed-events",
  "category": "module",
  "moduleClassName": "wp_seed_events_divi_event_visuals",
  "moduleOrderClassName": "wp_seed_events_divi_event_visuals",
  "usesContext": ["postId", "queryId"],
  "attributes": {
    "__loop_post_id": {"type": "string", "default": ""},
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {"meta": {"adminLabel": {"desktop": {"value": "WPSEvents — Visuels"}}}},
      "settings": {
        "meta": {"adminLabel": {}},
        "advanced": {"htmlAttributes": {}, "loop": {}}
      }
    },
    "content": {
      "type": "object",
      "default": {"innerContent": {"desktop": {"value": {
        "title": "", "show_title": "off", "heading_level": "h2",
        "show_document": "on", "link_original": "on", "lightbox": "off",
        "show_flyer": "on", "show_visuals": "on", "show_captions": "off",
        "image_size": "large", "click_action": "none"
      }}}},
      "settings": {"innerContent": {"groupType": "group-items", "items": {
        "showFlyer": {"groupSlug": "contentVisuals", "priority": 10, "render": true, "subName": "show_flyer", "label": "Flyer recto", "features": {"responsive": false, "dynamicContent": false}, "component": {"name": "divi/toggle", "type": "field", "props": {"options": {"off": "Masquer", "on": "Afficher"}}}},
        "showVisuals": {"groupSlug": "contentVisuals", "priority": 20, "render": true, "subName": "show_visuals", "label": "Autres visuels", "features": {"responsive": false, "dynamicContent": false}, "component": {"name": "divi/toggle", "type": "field", "props": {"options": {"off": "Masquer", "on": "Afficher"}}}},
        "showCaptions": {"groupSlug": "contentVisuals", "priority": 30, "render": true, "subName": "show_captions", "label": "Légendes", "features": {"responsive": false, "dynamicContent": false}, "component": {"name": "divi/toggle", "type": "field", "props": {"options": {"off": "Masquer", "on": "Afficher"}}}},
        "imageSize": {"groupSlug": "contentVisuals", "priority": 40, "render": true, "subName": "image_size", "label": "Taille d’image", "features": {"responsive": false, "dynamicContent": false}, "component": {"name": "divi/select", "type": "field", "props": {"options": {"thumbnail": {"label": "Miniature"}, "medium": {"label": "Moyenne"}, "medium_large": {"label": "Moyenne large"}, "large": {"label": "Grande"}, "full": {"label": "Taille originale"}}}}},
        "clickAction": {"groupSlug": "contentVisuals", "priority": 50, "render": true, "subName": "click_action", "label": "Action au clic", "features": {"responsive": false, "dynamicContent": false}, "component": {"name": "divi/select", "type": "field", "props": {"options": {"none": {"label": "Aucune"}, "lightbox": {"label": "Visionneuse"}, "original": {"label": "Image originale"}}}}}
      }}}
    },
    "titleStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-visuals__title"},
    "documentStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-visuals__document"},
    "documentLinkStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-visuals__document-link"},
    "sectionStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-visuals"},
    "listStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-visuals__list"},
    "gridStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-visuals.is-layout-grid .wp-seed-event-visuals__list"},
    "listLayoutStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-visuals.is-layout-vertical .wp-seed-event-visuals__list"},
    "figureStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-visuals__figure"},
    "imageLinkStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-visuals__image-link"},
    "eventListStyle": {
      "type": "object",
      "selector": "{{selector}} .wp-seed-event-visuals__list",
      "supportsCustomAttributes": true,
      "settings": {
        "decoration": {
          "layout": {
            "component": {
              "props": {
                "groupLabel": "Module",
                "dynamicSubgroupHost": true
              }
            }
          }
        }
      }
    },
    "itemStyle": {
      "type": "object",
      "selector": "{{selector}} .wp-seed-event-visuals__item",
      "settings": {
        "decoration": {
          "sizing": {"component": {"props": {"groupLabel": "Élément"}}}
        }
      }
    },
    "imageStyle": {
      "type": "object",
      "selector": "{{selector}} .wp-seed-event-visuals__image",
      "settings": {
        "decoration": {
          "sizing": {"component": {"props": {"groupLabel": "Image"}}}
        }
      }
    },
    "captionStyle": {"type": "object", "selector": "{{selector}} .wp-seed-event-visuals__caption", "settings": {"decoration": {"font": {"component": {"props": {"groupLabel": "Légende", "fieldLabel": "Légende"}}}}}}
  },
  "settings": {
    "content": "auto", "design": "auto", "advanced": "auto",
    "groups": {
      "contentVisuals": {"panel": "content", "priority": 10, "groupName": "contentVisuals", "multiElements": true, "component": {"name": "divi/composite", "props": {"groupLabel": "Visuels"}}}
    }
  }
}
