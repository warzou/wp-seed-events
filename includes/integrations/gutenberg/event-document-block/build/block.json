{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-seed-events/event-document-block",
  "version": "0.2.0-beta.9",
  "title": "WPSEvents — Document",
  "category": "widgets",
  "icon": "media-document",
  "description": "Affiche le document PDF canonique de l’événement courant.",
  "textdomain": "wp-seed-events",
  "attributes": {
    "show_document": {
      "type": "boolean",
      "default": true
    },
    "link_text": {
      "type": "string",
      "default": "Télécharger le document"
    },
    "name_display": {
      "type": "string",
      "default": "text_name",
      "enum": [
        "text",
        "name",
        "text_name"
      ]
    },
    "name_position": {
      "type": "string",
      "default": "inline",
      "enum": [
        "inline",
        "next_line"
      ]
    }
  },
  "usesContext": [
    "postId",
    "postType",
    "queryId"
  ],
  "supports": {
    "anchor": true,
    "customClassName": true,
    "html": false,
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "editorScript": "file:./index.js"
}