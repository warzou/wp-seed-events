{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-seed-events/event-dates-block",
  "version": "0.2.0-alpha.2",
  "title": "WP Seed — Dates de l’événement",
  "category": "widgets",
  "icon": "calendar-alt",
  "description": "Affiche les dates de l’événement courant.",
  "keywords": [
    "événement",
    "dates",
    "WP Seed"
  ],
  "textdomain": "wp-seed-events",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Dates"
    },
    "heading_level": {
      "type": "string",
      "default": "h2",
      "enum": [
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ]
    },
    "scope": {
      "type": "string",
      "default": "all",
      "enum": [
        "all",
        "upcoming",
        "past"
      ]
    },
    "mode": {
      "type": "string",
      "default": "all",
      "enum": [
        "next",
        "first",
        "last",
        "all"
      ]
    },
    "show_cancelled": {
      "type": "boolean",
      "default": true
    },
    "show_times": {
      "type": "boolean",
      "default": true
    },
    "show_calendar_links": {
      "type": "boolean",
      "default": true
    },
    "format": {
      "type": "string",
      "default": "long",
      "enum": [
        "long",
        "short"
      ]
    }
  },
  "usesContext": [
    "postId",
    "postType",
    "queryId"
  ],
  "supports": {
    "anchor": true,
    "customClassName": true,
    "html": false,
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "editorScript": "file:./index.js"
}