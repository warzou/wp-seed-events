{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-seed-events/occurrence-collection",
  "version": "0.2.0-beta.5",
  "title": "WP Seed Events — Collection d’occurrences",
  "category": "widgets",
  "icon": "schedule",
  "description": "Compose un modèle unique et le répète avec le contexte public de chaque occurrence.",
  "keywords": ["événement", "occurrence", "promotion", "WP Seed"],
  "textdomain": "wp-seed-events",
  "attributes": {
    "mode": {
      "type": "string",
      "default": "flat",
      "enum": ["flat", "grouped"]
    },
    "promotion": {
      "type": "string",
      "default": ""
    },
    "parcoursYear": {
      "type": "integer",
      "default": 0
    },
    "eventId": {
      "type": "integer",
      "default": 0
    },
    "eventType": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "default": "upcoming",
      "enum": ["upcoming", "past", "all"]
    },
    "pinned": {
      "type": "string",
      "default": "all",
      "enum": ["all", "only"]
    },
    "includeCancelled": {
      "type": "boolean",
      "default": false
    },
    "from": {
      "type": "string",
      "default": ""
    },
    "to": {
      "type": "string",
      "default": ""
    },
    "order": {
      "type": "string",
      "default": "chronological",
      "enum": ["upcoming", "chronological", "chronological_desc"]
    },
    "page": {
      "type": "integer",
      "default": 1
    },
    "perPage": {
      "type": "integer",
      "default": 20
    },
    "groupedLimit": {
      "type": "integer",
      "default": 200
    },
    "emptyMessage": {
      "type": "string",
      "default": "Aucune occurrence à afficher."
    },
    "collectionInstanceId": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "anchor": true,
    "customClassName": true,
    "html": false,
    "align": ["wide", "full"],
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    }
  },
  "editorScript": "file:./index.js"
}
