{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wp-seed-events/event-visuals-block",
  "version": "0.2.0-beta.9",
  "title": "WPSEvents — Visuels",
  "category": "widgets",
  "icon": "format-gallery",
  "description": "Affiche les visuels de communication de l’événement courant.",
  "keywords": ["événement", "visuels", "WP Seed"],
  "textdomain": "wp-seed-events",
  "attributes": {
    "show_document": {"type": "boolean", "default": true},
    "title": {
      "type": "string",
      "default": ""
    },
    "heading_level": {
      "type": "string",
      "default": "h2",
      "enum": ["h2", "h3", "h4", "h5", "h6"]
    },
    "show_flyer": {
      "type": "boolean",
      "default": true
    },
    "show_visuals": {
      "type": "boolean",
      "default": true
    },
    "show_captions": {
      "type": "boolean",
      "default": false
    },
    "image_size": {
      "type": "string",
      "default": "large"
    },
    "link_original": {
      "type": "boolean",
      "default": true
    },
    "lightbox": {
      "type": "boolean",
      "default": false
    },
    "click_action": {"type": "string", "default": "none", "enum": ["none", "lightbox", "original"]},
    "layout": {
      "type": "string",
      "default": "grid",
      "enum": ["vertical", "horizontal", "grid"]
    },
    "horizontal_gap": {"type": "string", "default": "24px"},
    "vertical_gap": {"type": "string", "default": "24px"},
    "align_items": {"type": "string", "default": "stretch"},
    "justify_content": {"type": "string", "default": "flex-start"},
    "wrap": {"type": "boolean", "default": true},
    "columns": {"type": "number", "default": 3},
    "columns_tablet": {"type": "number", "default": 2},
    "columns_phone": {"type": "number", "default": 1}
  },
  "usesContext": ["postId", "postType", "queryId"],
  "supports": {
    "anchor": true,
    "customClassName": true,
    "html": false,
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "editorScript": "file:./index.js"
}
