{
  "name": "wp-seed-events-build",
  "version": "0.1.23-dev",
  "private": true,
  "engines": {
    "node": ">=18.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run build:divi && npm run build:gutenberg",
    "build:divi": "cross-env NODE_ENV=production webpack --config includes/integrations/divi/event-dates-module/visual-builder/webpack.config.js",
    "build:gutenberg": "wp-scripts build --source-path=includes/integrations/gutenberg/event-dates-block/src --output-path=includes/integrations/gutenberg/event-dates-block/build",
    "watch:divi": "cross-env NODE_ENV=development webpack --watch --config includes/integrations/divi/event-dates-module/visual-builder/webpack.config.js",
    "start:gutenberg": "wp-scripts start --source-path=includes/integrations/gutenberg/event-dates-block/src --output-path=includes/integrations/gutenberg/event-dates-block/build",
    "test": "npm run test:divi && npm run test:gutenberg",
    "test:divi": "node includes/integrations/divi/event-dates-module/visual-builder/tests/module-contract.test.js",
    "test:gutenberg": "node includes/integrations/gutenberg/event-dates-block/tests/block-contract.test.js",
    "lint": "npm run lint:divi && npm run lint:gutenberg",
    "lint:divi": "node --check includes/integrations/divi/event-dates-module/visual-builder/webpack.config.js && node --check includes/integrations/divi/event-dates-module/visual-builder/tests/module-contract.test.js",
    "lint:gutenberg": "node --check includes/integrations/gutenberg/event-dates-block/tests/block-contract.test.js"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@babel/preset-react": "^7.24.1",
    "@wordpress/scripts": "33.0.0",
    "babel-loader": "^9.1.3",
    "cross-env": "^7.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
